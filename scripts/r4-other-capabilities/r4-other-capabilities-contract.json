      {
        "id": "package-installation-api",
        "regex": "(?i)\\b(?:android\\.content\\.pm\\.)?PackageInstaller\\b|\\b(?:ACTION_INSTALL_PACKAGE|REQUEST_INSTALL_PACKAGES|INSTALL_PACKAGES|DELETE_PACKAGES)\\b"
