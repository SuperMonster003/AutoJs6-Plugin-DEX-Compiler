        "pathKey": "validator",
        "literal": "Program JAR contains no class files"
      },
      {
        "pathKey": "engine",
        "literal": ".addProgramFiles(inputs.programJar.toPath())"
      },
      {
        "pathKey": "engine",
        "literal": ".setOutput(outputDirectory.toPath(), OutputMode.DexIndexed)"
      }
