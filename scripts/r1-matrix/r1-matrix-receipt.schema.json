{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autojs6.com/schemas/dex-compiler/r1-matrix-receipt-v1.json",
  "title": "AutoJs6 DEX Compiler R1 canonical matrix receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaignId",
    "receiptId",
    "matrixCellId",
    "evidenceClass",
    "outcome",
    "run",
    "repositories",
    "apks",
    "device",
    "safety",
    "input",
    "request",
    "provider",
    "output",
    "execution",
    "commands",
    "cleanup",
    "failure"
  ],
  "properties": {
    "schemaVersion": {
      "const": "autojs6.dex.r1.matrix-receipt/v1"
    },
    "campaignId": {
      "$ref": "#/definitions/uuid"
    },
    "receiptId": {
      "$ref": "#/definitions/uuid"
    },
    "matrixCellId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "evidenceClass": {
      "enum": ["CANONICAL", "SMOKE", "DIAGNOSTIC"]
    },
    "outcome": {
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAtUtc", "finishedAtUtc"],
      "properties": {
        "startedAtUtc": {
          "$ref": "#/definitions/utcTimestamp"
        },
        "finishedAtUtc": {
          "$ref": "#/definitions/utcTimestamp"
        }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "plugin"],
      "properties": {
        "host": {
          "$ref": "#/definitions/repositoryIdentity"
        },
        "plugin": {
          "$ref": "#/definitions/repositoryIdentity"
        }
      }
    },
    "apks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "plugin"],
      "properties": {
        "host": {
          "$ref": "#/definitions/apkIdentity"
        },
        "plugin": {
          "$ref": "#/definitions/apkIdentity"
        },
        "test": {
          "$ref": "#/definitions/testArtifactIdentity"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serial",
        "apiLevel",
        "abi",
        "allAbis",
        "kind",
        "avdName",
        "buildFingerprintSha256"
      ],
      "properties": {
        "serial": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$",
          "maxLength": 128
        },
        "apiLevel": {
          "type": "integer",
          "minimum": 21,
          "maximum": 100
        },
        "abi": {
          "$ref": "#/definitions/abi"
        },
        "allAbis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/abi"
          }
        },
        "kind": {
          "enum": ["PHYSICAL", "EMULATOR"]
        },
        "avdName": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "buildFingerprintSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userAuthorized",
        "explicitSerialEveryAdbCommand",
        "fakeProviderInstalled",
        "preflightStateSha256"
      ],
      "properties": {
        "userAuthorized": {
          "type": "boolean"
        },
        "explicitSerialEveryAdbCommand": {
          "type": "boolean"
        },
        "fakeProviderInstalled": {
          "type": "boolean"
        },
        "preflightStateSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusId", "sizeBytes", "sha256"],
      "properties": {
        "corpusId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilerPath",
        "mode",
        "minApi",
        "multiDexExpected",
        "outputFormat"
      ],
      "properties": {
        "compilerPath": {
          "enum": ["D8_CLI_FALLBACK", "D8_COMMAND"]
        },
        "mode": {
          "enum": ["DEBUG", "RELEASE"]
        },
        "minApi": {
          "type": "integer",
          "minimum": 24,
          "maximum": 36
        },
        "multiDexExpected": {
          "type": "boolean"
        },
        "outputFormat": {
          "const": "DEX_ZIP"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "component",
        "packageName",
        "uid",
        "versionName",
        "versionCode",
        "signerCertificateSha256",
        "protocolMajor",
        "protocolMinor",
        "runtimeLibraryFingerprintSha256",
        "compilerFamily",
        "compilerVersion",
        "capabilityDigestSha256"
      ],
      "properties": {
        "kind": {
          "enum": ["REAL", "FAKE"]
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.]+/[A-Za-z0-9_.$]+$",
          "maxLength": 256
        },
        "packageName": {
          "$ref": "#/definitions/packageName"
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "versionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "signerCertificateSha256": {
          "$ref": "#/definitions/signerSet"
        },
        "protocolMajor": {
          "type": "integer",
          "minimum": 1
        },
        "protocolMinor": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeLibraryFingerprintSha256": {
          "$ref": "#/definitions/sha256"
        },
        "compilerFamily": {
          "const": "D8"
        },
        "compilerVersion": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+._A-Za-z0-9]*)?$",
          "maxLength": 64
        },
        "capabilityDigestSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "sizeBytes",
        "sha256",
        "dexEntryCount",
        "entryManifestSha256"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "sha256": {
          "oneOf": [
            { "$ref": "#/definitions/sha256" },
            { "type": "null" }
          ]
        },
        "dexEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "entryManifestSha256": {
          "oneOf": [
            { "$ref": "#/definitions/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "passed",
        "className",
        "resultSha256"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "className": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 512
        },
        "resultSha256": {
          "oneOf": [
            { "$ref": "#/definitions/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "phase",
          "command",
          "exitCode",
          "stdoutSha256",
          "stderrSha256",
          "startedAtUtc",
          "finishedAtUtc"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "phase": {
            "enum": [
              "PREFLIGHT",
              "INSTALL",
              "TEST",
              "RECOVERY",
              "CLEANUP",
              "VERIFY"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "exitCode": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "stdoutSha256": {
            "$ref": "#/definitions/sha256"
          },
          "stderrSha256": {
            "$ref": "#/definitions/sha256"
          },
          "startedAtUtc": {
            "$ref": "#/definitions/utcTimestamp"
          },
          "finishedAtUtc": {
            "$ref": "#/definitions/utcTimestamp"
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "succeeded",
        "packagesRestoredToPreflight",
        "processesStopped",
        "workspaceClean",
        "postStateSha256"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "succeeded": {
          "type": "boolean"
        },
        "packagesRestoredToPreflight": {
          "type": "boolean"
        },
        "processesStopped": {
          "type": "boolean"
        },
        "workspaceClean": {
          "type": "boolean"
        },
        "postStateSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "code", "messageSha256"],
          "properties": {
            "stage": {
              "enum": [
                "PREFLIGHT",
                "INSTALL",
                "HANDSHAKE",
                "COMPILE",
                "VALIDATE",
                "LOAD",
                "EXECUTE",
                "CLEANUP",
                "INFRASTRUCTURE"
              ]
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            "messageSha256": {
              "$ref": "#/definitions/sha256"
            }
          }
        }
      ]
    },
    "notesSha256": {
      "$ref": "#/definitions/sha256"
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[1-8][A-Fa-f0-9]{3}-[89AaBb][A-Fa-f0-9]{3}-[A-Fa-f0-9]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^(?:[A-Fa-f0-9]{40}|[A-Fa-f0-9]{64})$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$",
      "maxLength": 256
    },
    "abi": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{2,32}$"
    },
    "signerSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/sha256"
      }
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionName",
        "versionCode",
        "commit",
        "treeState",
        "treeDigestSha256"
      ],
      "properties": {
        "versionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "commit": {
          "$ref": "#/definitions/gitCommit"
        },
        "treeState": {
          "enum": ["CLEAN", "DIRTY"]
        },
        "treeDigestSha256": {
          "$comment": "SHA-256 of the exact UTF-8 git status --porcelain=v1 -z --untracked-files=all payload. CLEAN therefore uses the SHA-256 of empty bytes; the canonical gate rejects DIRTY trees.",
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "apkIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "versionName",
        "versionCode",
        "sha256",
        "signerCertificateSha256"
      ],
      "properties": {
        "packageName": {
          "$ref": "#/definitions/packageName"
        },
        "versionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "signerCertificateSha256": {
          "$ref": "#/definitions/signerSet"
        }
      }
    },
    "testArtifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "sha256",
        "signerCertificateSha256"
      ],
      "properties": {
        "packageName": {
          "$ref": "#/definitions/packageName"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "signerCertificateSha256": {
          "$ref": "#/definitions/signerSet"
        }
      }
    }
  }
}
